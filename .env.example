# ==============================================================================
# AI-Powered SIEM Configuration Settings (Template)
# Copy this file to `.env` in the root or backend folder and fill in the values.
# ==============================================================================

# --- General App Configuration ---
APP_NAME="AI-Powered SIEM"
APP_ENV=development  # development, staging, production
DEBUG=True
PORT=8000
HOST=127.0.0.1

# --- Security & Core Credentials ---
# Generate a secure secret key using: openssl rand -hex 32
SECRET_KEY=generate_your_own_secure_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database Configurations ---
# Defaults to SQLite in the backend/ directory. 
# Swap to PostgreSQL connection string in production if desired.
DATABASE_URL=sqlite:///./siem_database.db

# --- Google Gemini AI API ---
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here

# --- WebSocket & Frontend CORS ---
# Allowed origins for CORS. Adjust if running frontend on a different port.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
